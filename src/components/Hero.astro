---
import type { Translations } from '@/i18n/translations'
import { IOS_DOWNLOAD_URL, PLAY_STORE_URL } from '@/lib/links'
import { buttonClass } from '@/lib/button'
import PhoneMockup from './PhoneMockup.astro'
import Lineart from './brand/Lineart.astro'
import Wave from './brand/Wave.astro'
import SplashPhone from './brand/SplashPhone.astro'
import StoreGlyph from './brand/StoreGlyph.astro'
import homeShot from '@/assets/screenshots/home.png'

interface Props {
  tr: Translations
}

const { tr } = Astro.props

// The headline is authored as three lines. The last one carries the brand
// accent, which is why it is split here rather than set with `whitespace-pre-line`.
const headlineLines = tr.hero.headline.split('\n')
---

<section class="brand-band on-brand overflow-hidden">
  {/* Decoration, back to front: the corner shade that keeps the headline
      readable wherever the gradient lands, then the contour pattern. */}
  <div class="brand-band-shade absolute inset-0 -z-20" aria-hidden="true"></div>
  {/* Anchored bottom left at its own aspect ratio rather than stretched over
      the section: stretching pulls the arcs up through the middle of the hero
      and they cut across the devices. */}
  <Lineart class="absolute bottom-0 left-0 -z-10 w-[130%] min-w-[80rem] max-w-none opacity-50" />

  <div
    class="container relative z-10 mx-auto grid min-h-dvh items-center gap-14 px-4 pt-28 pb-56 sm:pb-64 lg:grid-cols-12 lg:gap-8 lg:pb-48"
  >
    <div class="lg:col-span-7 lg:pr-8">
      <h1 class="text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
        {
          headlineLines.map((line, i) => (
            <span
              class:list={[
                'block',
                i === headlineLines.length - 1 && 'text-brand-mint',
              ]}
            >
              {line}
            </span>
          ))
        }
      </h1>

      <p class="mt-8 max-w-xl text-lg leading-relaxed text-white/85 md:text-xl">
        {tr.hero.sub}
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={IOS_DOWNLOAD_URL}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonClass('onBrand')}
        >
          <StoreGlyph store="ios" />
          {tr.hero.ctaIos}
        </a>
        <a
          href={PLAY_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonClass('onBrandGlass')}
        >
          <StoreGlyph store="android" />
          {tr.hero.ctaAndroid}
        </a>
      </div>

      <p class="mt-5 text-sm text-white/70">{tr.hero.note}</p>
    </div>

    {/* Two devices: the screenshot in front, the launch screen behind it and
        turned out of alignment, so the pair reads as a stack rather than as one
        phone with a shadow. */}
    <div class="lg:col-span-5">
      {/* The screenshot sets the size of the stack; the launch screen hangs off
          it, up and to the right, and is allowed to run past the column into
          the hero's own overflow. */}
      <div class="relative mx-auto w-48 sm:w-56 lg:w-72 lg:translate-x-[-22%] lg:translate-y-16">
        <SplashPhone
          tagline={tr.footer.tagline}
          class="absolute -top-16 left-[84%] hidden w-full rotate-[7deg] sm:block"
        />
        <PhoneMockup
          src={homeShot}
          alt={tr.hero.imageAlt}
          class="relative z-10 w-full -rotate-2"
          eager
        />
      </div>
    </div>
  </div>

  {/* The hand-over into the white page. It sits under the devices on purpose:
      the front phone crossing the white edge is what ties the two together. */}
  <Wave class="absolute inset-x-0 -bottom-px h-[clamp(9rem,32vw,28rem)]" />
</section>
