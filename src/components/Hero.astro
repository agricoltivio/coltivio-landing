---
import type { Translations } from '@/i18n/translations'
import { Image } from 'astro:assets'
import Lineart from './brand/Lineart.astro'
import Wave from './brand/Wave.astro'
import LogoMark from './brand/LogoMark.astro'
import StoreBadge from './brand/StoreBadge.astro'
import homeDevice from '@/assets/screenshots/home-device.png'
import splashDevice from '@/assets/screenshots/splash-device.png'

interface Props {
  tr: Translations
  lang: string
}

const { tr, lang } = Astro.props

// The headline is authored as three lines. The last one carries the brand
// accent, which is why it is split here rather than set with `whitespace-pre-line`.
const headlineLines = tr.hero.headline.split('\n')

// The device renders are 844px wide and the frame is laid out at 288px, so this
// is the source resolution. Asking for more upscales the render, asking for less
// resamples it twice, once here and once on the way to the screen.
const DEVICE_RENDER_WIDTH = 844
---

<section class="brand-band on-brand overflow-hidden">
  {/* Decoration, back to front: the corner shade that keeps the headline
      readable wherever the gradient lands, the leaf mark blown up until only
      its crests clear the wave, then the contour pattern over both. */}
  <div class="brand-band-shade absolute inset-0 -z-30" aria-hidden="true"></div>
  {/* Sampled off the reference: the watermark sits a little *lighter* than the
      gradient behind it, not darker. Sage at thirty percent lands on the same
      values. The wrapper carries the colour because `--logo-mark` is what the
      mark's fill resolves against, and a CSS variable inherits. */}
  <div
    class="absolute top-[36%] -left-[13%] -z-20 h-[64%]"
    style="--logo-mark: color-mix(in oklab, var(--brand-sage) 34%, transparent); --logo-mark-to: color-mix(in oklab, var(--brand-sage) 8%, transparent)"
    aria-hidden="true"
  >
    <LogoMark shaded class="h-full w-auto" />
  </div>
  {/* A band across the bottom, not a layer over the section. Sized in both
      directions so the arcs stay flat and lie under the content. */}
  <Lineart class="absolute inset-x-0 bottom-0 -z-10 h-[82%] opacity-60" />

  <div
    class="container relative z-10 mx-auto grid min-h-dvh items-center gap-14 px-4 pt-28 pb-56 sm:pb-64 lg:grid-cols-12 lg:gap-8 lg:pb-48"
  >
    <div class="lg:col-span-7 lg:pr-8">
      <h1 class="text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
        {
          headlineLines.map((line, i) => (
            <span
              class:list={[
                'block',
                i === headlineLines.length - 1 && 'text-brand-mint',
              ]}
            >
              {line}
            </span>
          ))
        }
      </h1>

      <p class="mt-8 max-w-xl text-lg leading-relaxed text-white/85 md:text-xl">
        {tr.hero.sub}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <StoreBadge store="ios" lang={lang} label={tr.hero.ctaIos} class="h-10" />
        <StoreBadge store="android" lang={lang} label={tr.hero.ctaAndroid} class="h-10" />
      </div>

      <p class="mt-5 text-sm text-white/70">{tr.hero.note}</p>
    </div>

    {/* Two devices: the screenshot in front, the launch screen behind it and
        turned out of alignment, so the pair reads as a stack rather than as one
        phone with a shadow. */}
    <div class="lg:col-span-5">
      {/* The screenshot sets the size of the stack; the launch screen hangs off
          it, up and to the right, and is allowed to run past the column into
          the hero's own overflow. */}
      <div class="relative mx-auto w-48 sm:w-56 lg:w-72 lg:translate-x-[-22%] lg:translate-y-16">
        <Image
          src={splashDevice}
          alt=""
          width={DEVICE_RENDER_WIDTH}
          loading="eager"
          class="absolute -top-16 left-[84%] hidden w-full rotate-[7deg] drop-shadow-[0_6px_14px_rgb(0_0_0_/_0.25)] sm:block"
          aria-hidden="true"
        />
        {/* Shipped as a rendered device, frame and all, rather than a
            screenshot dropped into a drawn frame: the app's own screen ends
            mid-tile, and a drawn frame makes that read as a cropping mistake
            instead of as a screen that scrolls on. */}
        <Image
          src={homeDevice}
          alt={tr.hero.imageAlt}
          width={DEVICE_RENDER_WIDTH}
          loading="eager"
          fetchpriority="high"
          class="relative z-10 w-full -rotate-2 drop-shadow-[0_6px_14px_rgb(0_0_0_/_0.25)]"
        />
      </div>
    </div>
  </div>

  {/* The hand-over into the white page. It sits under the devices on purpose:
      the front phone crossing the white edge is what ties the two together. */}
  <Wave fill="var(--surface)" class="absolute inset-x-0 -bottom-px h-[clamp(9rem,32vw,28rem)]" />
</section>
