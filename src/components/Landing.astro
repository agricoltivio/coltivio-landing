---
import type { Translations } from '@/i18n/translations'
import { IOS_DOWNLOAD_URL, PLAY_STORE_URL, GITHUB_URL } from '@/lib/links'
import { buttonClass } from '@/lib/button'
import { NewsletterForm } from './NewsletterForm'
import { StatutenDialog } from './StatutenDialog'
import { DonationForm } from './DonationForm'
import SiteHeader from './SiteHeader.astro'
import Hero from './Hero.astro'
import PhoneMockup from './PhoneMockup.astro'
import Logo from './brand/Logo.astro'
import BrandIcon from './brand/BrandIcon.astro'
import Lineart from './brand/Lineart.astro'
import Wave from './brand/Wave.astro'
import StoreGlyph from './brand/StoreGlyph.astro'
import fieldworkShot from '@/assets/screenshots/fieldwork.png'
import animalsShot from '@/assets/screenshots/animals.png'

interface Props {
  tr: Translations
  lang: string
}

const { tr, lang } = Astro.props

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.coltivio.ch'
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'https://api.coltivio.ch'

// Each pillar carries its own CTA: the app itself, the source, the association.
const pillars = [
  {
    ...tr.pillars.admin,
    links: [
      { label: tr.footer.appStore, href: IOS_DOWNLOAD_URL },
      { label: tr.footer.playStore, href: PLAY_STORE_URL },
    ],
  },
  {
    ...tr.pillars.verein,
    links: [{ label: tr.membership.cta, href: `${appUrl}/membership`, authRedirect: '/membership' }],
  },
  {
    ...tr.pillars.oss,
    links: [{ label: tr.oss.github, href: GITHUB_URL }],
  },
]

// Heading scale, so the same level never renders at two sizes.
const H2_SECTION = 'text-3xl font-bold tracking-tight md:text-4xl'  // primary sections
const H2_MINOR = 'text-2xl font-bold tracking-tight'                // supporting sections
const H3_SUBSECTION = 'text-2xl font-bold tracking-tight'           // groups inside a section
const CARD_TITLE = 'font-semibold'                                  // any card, at any depth

// Section rhythm. The page alternates white and the tinted ground instead of
// separating every band with a rule, so the two gradient bands and the footer
// are the only hard colour changes on the page.
const SECTION = 'py-20 md:py-24'
const CARD =
  'rounded-lg border bg-card text-card-foreground p-6 shadow-sm transition-colors hover:border-brand-sage'
// The same card on a gradient band, where a white block would punch a hole.
const CARD_ON_BRAND = 'rounded-lg border border-white/25 bg-white/10 p-6 backdrop-blur-sm'
const EYEBROW = 'text-xs font-semibold uppercase tracking-widest text-primary'

const membershipBenefits = [
  tr.membership.benefits.carry,
  tr.membership.benefits.voice,
  tr.membership.benefits.support,
  tr.membership.benefits.community,
]

// `['export']` rather than `.export`: the Astro compiler scans the frontmatter
// for module-level `export` statements, and a bare `export` token, even as a
// property name, is enough to make it cut the expression in half. The bracket
// form hides it inside a string. The template is not affected, only this block.
const fieldworkCards = [tr.fieldwork.plots, tr.fieldwork.protection, tr.fieldwork.harvest, tr.fieldwork['export']]

const animalCards = [tr.animals.import, tr.animals.treatments, tr.animals.turnout, tr.animals['export']]

const moreCards = [
  tr.more.multiUser,
  tr.more.multiFarm,
  tr.more.tasks,
  tr.more.journals,
  tr.more.wiki,
  tr.more.stats,
]

const webappCards = [
  tr.webapp.contacts,
  tr.webapp.orders,
  tr.webapp.sponsorships,
  tr.webapp.community,
]

const customizeCards = [tr.customize.speedDial, tr.customize.modules]

const legalLinks = [
  { href: lang === 'de' ? '/imprint' : `/${lang}/imprint`, label: tr.imprint.title },
  { href: lang === 'de' ? '/privacy' : `/${lang}/privacy`, label: tr.privacy.title },
  { href: lang === 'de' ? '/data-deletion' : `/${lang}/data-deletion`, label: tr.dataDeletion.title },
]
---

<div class="min-h-dvh bg-background text-foreground">
  <SiteHeader tr={tr} lang={lang} appUrl={appUrl} />

  <main id="main">

  <Hero tr={tr} />

  {/* ── Pillars ────────────────────────────────────────────── */}
  <section class={SECTION}>
    <div class="container mx-auto px-4">
      <h2 class="sr-only">{tr.pillars.title}</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {pillars.map((pillar) => (
          <div class:list={[CARD, 'flex flex-col']}>
            <h3 class={CARD_TITLE}>{pillar.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{pillar.desc}</p>
            {/* The three pillars are peers, so their calls to action all get the
                same weight. The one loud membership button lives on the band. */}
            <div class="mt-auto flex flex-wrap gap-2 pt-6">
              {pillar.links.map((link) => (
                <a
                  href={link.href}
                  data-auth-redirect={link.authRedirect}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={buttonClass('secondary', 'sm')}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Story ──────────────────────────────────────────────── */}
  <section class:list={[SECTION, 'bg-surface']}>
    <div class="container mx-auto max-w-3xl space-y-10 px-4">
      <h2 class={H2_SECTION}>{tr.story.headline}</h2>
      <div class="space-y-4 text-lg leading-relaxed text-muted-foreground">
        <p>{tr.story.founders}</p>
        <p>{tr.story.problem}</p>
        <p class="font-medium text-foreground">{tr.story.born}</p>
      </div>
    </div>
  </section>

  {/* ── Membership ─────────────────────────────────────────── */}
  {/* The second gradient band. The two waves carry the neighbouring grounds,
      so the band keeps one uninterrupted gradient behind them. */}
  <section id="membership" class="brand-band on-brand overflow-hidden">
    <div class="brand-band-shade absolute inset-0 -z-20" aria-hidden="true"></div>
    <Lineart class="absolute inset-0 -z-10 h-full w-full opacity-50" />
    <Wave edge="top" fill="var(--surface)" class="absolute inset-x-0 -top-px h-[clamp(5rem,16vw,11rem)]" />
    <Wave flip fill="var(--background)" class="absolute inset-x-0 -bottom-px h-[clamp(5rem,16vw,11rem)]" />

    <div class="container relative z-10 mx-auto max-w-3xl space-y-6 px-4 pt-[22vw] pb-[22vw] sm:pt-40 sm:pb-40 md:pt-48 md:pb-48">
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-mint">{tr.membership.eyebrow}</p>
        <h2 class={H2_SECTION}>{tr.membership.tagline}</h2>
      </div>
      <p class="text-lg leading-relaxed text-white/85">{tr.membership.body}</p>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {membershipBenefits.map((benefit) => (
          <div class={CARD_ON_BRAND}>
            <h3 class={CARD_TITLE}>{benefit.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/80">{benefit.desc}</p>
          </div>
        ))}
      </div>

      <p class="leading-relaxed text-white/85">{tr.membership.price}</p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href={`${appUrl}/membership`}
          data-auth-redirect="/membership"
          target="_blank"
          rel="noopener noreferrer"
          class={buttonClass('onBrandAccent')}
        >
          {tr.membership.cta}
        </a>
        <StatutenDialog client:load lang={lang} linkLabel={tr.oss.statutenLink} closeLabel={tr.a11y.close} variant="onBrandGlass" />
      </div>
    </div>
  </section>

  {/* ── Features ───────────────────────────────────────────── */}
  <section id="features" class={SECTION}>
    <div class="container mx-auto space-y-20 px-4">
      <h2 class={EYEBROW}>{tr.fieldwork.sub}</h2>

      {/* Field Work */}
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div class="space-y-6">
          <div class="flex items-center gap-3">
            <BrandIcon name="plots" class="h-8 w-8 shrink-0 text-primary" />
            <h3 class={H3_SUBSECTION}>{tr.fieldwork.title}</h3>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {fieldworkCards.map((card) => (
              <div class={CARD}>
                <h4 class={CARD_TITLE}>{card.title}</h4>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{card.desc}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="flex justify-center">
          <PhoneMockup src={fieldworkShot} alt={tr.fieldwork.imageAlt} class="w-52 lg:rotate-3" />
        </div>
      </div>

      {/* Animal Husbandry */}
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        {/* One element, reordered: below the text on small screens, left of it from lg */}
        <div class="order-2 flex justify-center lg:order-1">
          <PhoneMockup src={animalsShot} alt={tr.animals.imageAlt} class="w-52 lg:-rotate-3" />
        </div>
        <div class="order-1 space-y-6 lg:order-2">
          <div class="flex items-center gap-3">
            <BrandIcon name="animals" class="h-8 w-8 shrink-0 text-primary" />
            <h3 class={H3_SUBSECTION}>{tr.animals.title}</h3>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {animalCards.map((card) => (
              <div class={CARD}>
                <h4 class={CARD_TITLE}>{card.title}</h4>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{card.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* More features */}
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {moreCards.map((card) => (
          <div class={CARD}>
            <h3 class={CARD_TITLE}>{card.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Customization ──────────────────────────────────────── */}
  <section class:list={[SECTION, 'bg-surface']}>
    <div class="container mx-auto max-w-3xl space-y-10 px-4">
      <div class="space-y-4">
        <h2 class={H2_SECTION}>{tr.customize.headline}</h2>
        <p class="text-lg leading-relaxed text-muted-foreground">{tr.customize.sub}</p>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {customizeCards.map((card) => (
          <div class={CARD}>
            <h3 class={CARD_TITLE}>{card.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Web App ────────────────────────────────────────────── */}
  <section id="webapp" class={SECTION}>
    <div class="container mx-auto max-w-3xl space-y-6 px-4">
      <p class={EYEBROW}>{tr.webapp.label}</p>
      <h2 class={H2_SECTION}>{tr.webapp.title}</h2>
      <p class="text-muted-foreground">{tr.webapp.body}</p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {webappCards.map((card) => (
          <div class={CARD}>
            <h3 class={CARD_TITLE}>{card.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{card.desc}</p>
          </div>
        ))}
      </div>
      <div class="pt-2">
        <a
          href={appUrl}
          data-auth-redirect="/dashboard"
          target="_blank"
          rel="noopener noreferrer"
          class={buttonClass('primary')}
        >
          {tr.nav.openApp}
        </a>
      </div>
    </div>
  </section>

  {/* ── OSS ────────────────────────────────────────────────── */}
  <section id="about" class:list={[SECTION, 'bg-surface']}>
    <div class="container mx-auto max-w-3xl space-y-8 px-4">
      <h2 class={H2_SECTION}>{tr.story.ossTitle}</h2>
      <div class="space-y-4 leading-relaxed text-muted-foreground">
        <p class="font-medium text-foreground">{tr.story.verein}</p>
        <p>{tr.story.vereinPurpose}</p>
        <p>{tr.story.vereinGovernance}</p>
        <p>{tr.story.oss}</p>
        <p>{tr.story.data}</p>
        <p>{tr.story.funding}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonClass('secondary')}
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          {tr.oss.github}
        </a>
        <StatutenDialog client:load lang={lang} linkLabel={tr.oss.statutenLink} closeLabel={tr.a11y.close} />
      </div>
    </div>
  </section>

  {/* ── Newsletter ──────────────────────────────── */}
  {/* The quiet ask, deliberately kept off the band: two calls to action side by
      side, each with its own loud button, read as a wall of controls at the very
      point where the page should be easiest to leave. */}
  <section class={SECTION}>
    <div class="container mx-auto max-w-2xl space-y-6 px-4">
      <h2 class={H2_MINOR}>{tr.newsletter.title}</h2>
      <p class="text-muted-foreground">{tr.newsletter.sub}</p>
      <NewsletterForm
        client:load
        apiUrl={apiUrl}
        lang={lang}
        label={tr.newsletter.label}
        placeholder={tr.newsletter.placeholder}
        cta={tr.newsletter.cta}
        successMsg={tr.newsletter.success}
        errorMsg={tr.newsletter.error}
        captchaMsg={tr.newsletter.captcha}
      />
    </div>
  </section>

  {/* ── Donate ─────────────────────────────────── */}
  {/* The third and last gradient band, carrying one ask and one loud button.
      It hands over to the footer with a wave filled in the footer's ink, which
      is what keeps the wave running to the bottom of the page instead of
      stopping after the membership. */}
  <section id="donate" class="brand-band on-brand overflow-hidden">
    <div class="brand-band-shade absolute inset-0 -z-20" aria-hidden="true"></div>
    <Lineart class="absolute inset-0 -z-10 h-full w-full opacity-40" />
    {/* Mirrored the other way round from the membership band, so the two do not
        trace the same line twice on one page. */}
    <Wave edge="top" flip fill="var(--background)" class="absolute inset-x-0 -top-px h-[clamp(4rem,14vw,9rem)]" />
    <Wave fill="var(--brand-ink)" class="absolute inset-x-0 -bottom-px h-[clamp(4rem,14vw,9rem)]" />

    <div class="container relative z-10 mx-auto max-w-2xl space-y-6 px-4 pt-[20vw] pb-[20vw] sm:pt-32 sm:pb-32 md:pt-36 md:pb-36">
      <h2 class={H2_MINOR}>{tr.donate.title}</h2>
      <p class="leading-relaxed text-white/85">{tr.donate.sub}</p>
      <DonationForm
        client:load
        onDark
        apiUrl={apiUrl}
        lang={lang}
        amountLabel={tr.donate.amountLabel}
        customPlaceholder={tr.donate.customPlaceholder}
        emailLabel={tr.donate.emailLabel}
        emailPlaceholder={tr.donate.emailPlaceholder}
        cta={tr.donate.cta}
        processing={tr.donate.processing}
        error={tr.donate.error}
        errorAmount={tr.donate.errorAmount}
        errorEmail={tr.donate.errorEmail}
        thankYouTitle={tr.donate.thankYouTitle}
        thankYouBody={tr.donate.thankYouBody}
        thankYouClose={tr.donate.thankYouClose}
        closeLabel={tr.a11y.close}
      />
    </div>
  </section>

  </main>

  {/* ── Footer ─────────────────────────────────────────────── */}
  <footer class="relative isolate overflow-hidden bg-brand-ink text-white">
    {/* No wave of its own: the support band above already curves into this
        ground, so a second curve here would double the edge. */}
    <Lineart class="absolute inset-x-0 bottom-0 -z-10 h-2/3 w-full opacity-25" />

    <div class="container relative z-10 mx-auto space-y-8 px-4 pt-16 pb-12">
      <div class="flex flex-wrap items-center justify-between gap-6">
        <div class="space-y-3">
          <Logo class="h-8 w-auto" />
          <p class="text-sm text-white/70">{tr.footer.tagline}</p>
        </div>
        <div class="flex flex-wrap gap-2 text-sm">
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="rounded-md px-3 py-1.5 text-white/75 transition-colors hover:bg-white/10 hover:text-white">
            {tr.footer.github}
          </a>
          <a href={IOS_DOWNLOAD_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md px-3 py-1.5 text-white/75 transition-colors hover:bg-white/10 hover:text-white">
            <StoreGlyph store="ios" class="h-4 w-4 shrink-0" />
            {tr.footer.appStore}
          </a>
          <a href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md px-3 py-1.5 text-white/75 transition-colors hover:bg-white/10 hover:text-white">
            <StoreGlyph store="android" class="h-4 w-4 shrink-0" />
            {tr.footer.playStore}
          </a>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-4 border-t border-white/15 pt-6 text-sm text-white/70">
        {legalLinks.map((link) => (
          <a href={link.href} class="rounded-md transition-colors hover:text-white hover:underline">{link.label}</a>
        ))}
        <span class="ml-auto">© 2026 Coltivio</span>
      </div>
    </div>
  </footer>

</div>

<script define:vars={{ appUrl }} is:inline>
  // Read token from hash fragment (e.g. #token=...)
  // Hash is used so the token never reaches the server or appears in analytics/logs.
  const hash = window.location.hash.slice(1)
  if (hash) {
    const params = new URLSearchParams(hash)
    const token = params.get('token')
    if (token) {
      sessionStorage.setItem('coltivio_token', token)
      // Remove hash from URL so the token doesn't linger in browser history
      history.replaceState(null, '', window.location.pathname + window.location.search)
    }
  }

  // Rewrite all [data-auth-redirect] links to the token-exchange URL if token exists
  const token = sessionStorage.getItem('coltivio_token')
  if (token) {
    document.querySelectorAll('[data-auth-redirect]').forEach((el) => {
      const redirect = el.getAttribute('data-auth-redirect')
      el.setAttribute(
        'href',
        `${appUrl}/auth/token#token=${encodeURIComponent(token)}&redirect=${encodeURIComponent(redirect)}`
      )
    })
  }
</script>
