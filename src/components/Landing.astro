<script define:vars={{ appUrl }} is:inline>
  // Read token from hash fragment (e.g. #token=...)
  // Hash is used so the token never reaches the server or appears in analytics/logs.
  const hash = window.location.hash.slice(1)
  if (hash) {
    const params = new URLSearchParams(hash)
    const token = params.get('token')
    if (token) {
      sessionStorage.setItem('coltivio_token', token)
      // Remove hash from URL so the token doesn't linger in browser history
      history.replaceState(null, '', window.location.pathname + window.location.search)
    }
  }

  // Rewrite all [data-auth-redirect] links to the token-exchange URL if token exists
  const token = sessionStorage.getItem('coltivio_token')
  if (token) {
    document.querySelectorAll('[data-auth-redirect]').forEach((el) => {
      const redirect = el.getAttribute('data-auth-redirect')
      el.setAttribute(
        'href',
        `${appUrl}/auth/token#token=${encodeURIComponent(token)}&redirect=${encodeURIComponent(redirect)}`
      )
    })
  }
</script>
