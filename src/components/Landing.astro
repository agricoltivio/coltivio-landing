---
import type { Translations } from '@/i18n/translations'
import { IOS_DOWNLOAD_URL, PLAY_STORE_URL, GITHUB_URL } from '@/lib/links'
import { NewsletterForm } from './NewsletterForm'
import { LanguageSwitcher } from './LanguageSwitcher'
import { MobileNav } from './MobileNav'
import { StatutenDialog } from './StatutenDialog'
import { DonationForm } from './DonationForm'
import PhoneMockup from './PhoneMockup.astro'
import homeShot from '@/assets/screenshots/home.png'
import fieldworkShot from '@/assets/screenshots/fieldwork.png'
import animalsShot from '@/assets/screenshots/animals.png'

interface Props {
  tr: Translations
  lang: string
}

const { tr, lang } = Astro.props

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.coltivio.ch'
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'https://api.coltivio.ch'

// Each pillar carries its own CTA: the app itself, the source, the association.
interface PillarLink {
  label: string
  href: string
  authRedirect?: string
}

const pillars: { title: string; desc: string; links: PillarLink[] }[] = [
  {
    ...tr.pillars.admin,
    links: [
      { label: tr.footer.appStore, href: IOS_DOWNLOAD_URL },
      { label: tr.footer.playStore, href: PLAY_STORE_URL },
    ],
  },
  {
    ...tr.pillars.verein,
    links: [{ label: tr.membership.cta, href: `${appUrl}/membership`, authRedirect: '/membership' }],
  },
  {
    ...tr.pillars.oss,
    links: [{ label: tr.oss.github, href: GITHUB_URL }],
  },
]

const membershipBenefits = [
  tr.membership.benefits.carry,
  tr.membership.benefits.voice,
  tr.membership.benefits.support,
  tr.membership.benefits.webapp,
]
---

<div class="min-h-screen bg-background text-foreground">

  {/* ── Navbar ─────────────────────────────────────────────── */}
  <header class="sticky top-0 z-50 border-b bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60">
    <div class="container mx-auto flex h-14 items-center justify-between px-4">
      <div class="flex items-center gap-2 font-semibold text-lg">
        <img src="/logo.png" alt="Coltivio" class="h-7" />
        Coltivio
      </div>

      {/* Desktop nav links */}
      <nav class="hidden lg:flex items-center gap-1 text-sm font-medium">
        <a href="#features" class="px-3 py-1.5 rounded hover:bg-muted transition-colors">{tr.nav.features}</a>
        <a href="#webapp" class="px-3 py-1.5 rounded hover:bg-muted transition-colors">{tr.nav.webapp}</a>
        <a href="#membership" class="px-3 py-1.5 rounded hover:bg-muted transition-colors">{tr.nav.membership}</a>
        <a href="#about" class="px-3 py-1.5 rounded hover:bg-muted transition-colors">{tr.nav.about}</a>
      </nav>

      <div class="flex items-center gap-2">
        {/* Open App: desktop only */}
        <a
          href={appUrl}
          data-auth-redirect="/dashboard"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-flex rounded-md border border-input bg-background px-4 py-1.5 text-sm font-medium hover:bg-muted transition-colors"
        >
          {tr.nav.openApp}
        </a>
        {/* Become Member: always visible */}
        <a
          href={`${appUrl}/membership`}
          data-auth-redirect="/membership"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex rounded-md bg-primary px-4 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          {tr.membership.cta}
        </a>
        {/* Lang switcher: desktop only */}
        <div class="hidden lg:block">
          <LanguageSwitcher client:load lang={lang} />
        </div>
        {/* Mobile hamburger */}
        <MobileNav
          client:load
          lang={lang}
          appUrl={appUrl}
          labels={{
            features: tr.nav.features,
            webapp: tr.nav.webapp,
            membership: tr.nav.membership,
            about: tr.nav.about,
            openApp: tr.nav.openApp,
            membershipCta: tr.membership.cta,
            menu: tr.a11y.menu,
            openMenu: tr.a11y.openMenu,
            closeMenu: tr.a11y.closeMenu,
          }}
        />
      </div>
    </div>
  </header>

  {/* ── Hero ───────────────────────────────────────────────── */}
  <section class="container mx-auto flex min-h-[calc(100vh-3.5rem)] items-center px-4 py-16">
    <div class="grid gap-12 md:grid-cols-2 md:items-center w-full">
      <div class="space-y-6">
        <h1 class="text-4xl font-bold tracking-tight md:text-7xl whitespace-pre-line">
          {tr.hero.headline}
        </h1>
        <p class="text-lg text-muted-foreground max-w-lg md:text-xl">
          {tr.hero.sub}
        </p>
        <div class="space-y-4">
          <div class="flex flex-wrap gap-3">
            <a
              href={IOS_DOWNLOAD_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-base font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
            >
              {tr.hero.ctaIos}
            </a>
            <a
              href={PLAY_STORE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-md border border-input bg-background px-6 py-3 text-base font-medium hover:bg-muted transition-colors"
            >
              {tr.hero.ctaAndroid}
            </a>
          </div>
          <p class="text-sm text-muted-foreground">
            {tr.hero.note}
          </p>
        </div>
      </div>

      <div class="flex justify-center md:justify-end lg:justify-center">
        <PhoneMockup src={homeShot} alt={tr.hero.imageAlt} rotate="md:-rotate-3" wrapper="flex md:order-first" eager />
      </div>
    </div>
  </section>

  {/* ── Pillars ────────────────────────────────────────────── */}
  <section class="border-t py-16">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {pillars.map((pillar) => (
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="flex h-full flex-col pt-6 px-6 pb-6">
              <h3 class="font-semibold">{pillar.title}</h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{pillar.desc}</p>
              <div class="mt-auto pt-4 flex flex-wrap gap-x-5 gap-y-2">
                {pillar.links.map((link) => (
                  <a
                    href={link.href}
                    data-auth-redirect={link.authRedirect}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-medium text-primary hover:underline"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Story ──────────────────────────────────────────────── */}
  <section class="border-t py-20">
    <div class="container mx-auto px-4 max-w-3xl space-y-10">
      <h2 class="text-3xl font-bold md:text-4xl">{tr.story.headline}</h2>
      <div class="space-y-4 text-muted-foreground text-lg leading-relaxed">
        <p>{tr.story.founders}</p>
        <p>{tr.story.problem}</p>
        <p class="text-foreground font-medium">{tr.story.born}</p>
      </div>
    </div>
  </section>

  {/* ── Membership ─────────────────────────────────────────── */}
  <section id="membership" class="border-t bg-primary/5 py-20">
    <div class="container mx-auto px-4 max-w-3xl space-y-6">
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary">{tr.membership.eyebrow}</p>
        <h2 class="text-3xl font-bold md:text-4xl">{tr.membership.tagline}</h2>
      </div>
      <p class="text-lg text-muted-foreground leading-relaxed">{tr.membership.body}</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {membershipBenefits.map((benefit) => (
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <h4 class="font-semibold">{benefit.title}</h4>
              <p class="text-sm text-muted-foreground leading-relaxed">{benefit.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="text-muted-foreground leading-relaxed">{tr.membership.price}</p>

      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href={`${appUrl}/membership`}
          data-auth-redirect="/membership"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-base font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          {tr.membership.cta}
        </a>
        <StatutenDialog client:load lang={lang} linkLabel={tr.oss.statutenLink} closeLabel={tr.a11y.close} />
      </div>
    </div>
  </section>

  {/* ── Features ───────────────────────────────────────────── */}
  <section id="features" class="border-t py-20">
    <div class="container mx-auto px-4 space-y-20">
      <p class="text-sm font-medium text-muted-foreground uppercase tracking-wider">
        {tr.fieldwork.sub}
      </p>

      {/* Field Work */}
      <div class="grid gap-12 lg:grid-cols-2 md:items-center">
        <div class="space-y-6">
          <h3 class="text-2xl font-bold">{tr.fieldwork.title}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
              <div class="pt-6 px-6 pb-6 space-y-2">
                <h4 class="font-semibold">{tr.fieldwork.plots.title}</h4>
                <p class="text-sm text-muted-foreground leading-relaxed">{tr.fieldwork.plots.desc}</p>
              </div>
            </div>
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
              <div class="pt-6 px-6 pb-6 space-y-2">
                <h4 class="font-semibold">{tr.fieldwork.protection.title}</h4>
                <p class="text-sm text-muted-foreground leading-relaxed">{tr.fieldwork.protection.desc}</p>
              </div>
            </div>
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
              <div class="pt-6 px-6 pb-6 space-y-2">
                <h4 class="font-semibold">{tr.fieldwork.harvest.title}</h4>
                <p class="text-sm text-muted-foreground leading-relaxed">{tr.fieldwork.harvest.desc}</p>
              </div>
            </div>
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
              <div class="pt-6 px-6 pb-6 space-y-2">
                <h4 class="font-semibold">{tr.fieldwork.export.title}</h4>
                <p class="text-sm text-muted-foreground leading-relaxed">{tr.fieldwork.export.desc}</p>
              </div>
            </div>
          </div>
        </div>
        <PhoneMockup src={fieldworkShot} alt={tr.fieldwork.imageAlt} rotate="lg:rotate-3" />
      </div>

      {/* Animal Husbandry */}
      <div class="grid gap-12 lg:grid-cols-2 md:items-center">
        {/* Desktop: image left */}
        <PhoneMockup src={animalsShot} alt={tr.animals.imageAlt} rotate="lg:-rotate-3" wrapper="hidden lg:flex" />
        <div class="space-y-6">
          <h3 class="text-2xl font-bold">{tr.animals.title}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
              <div class="pt-6 px-6 pb-6 space-y-2">
                <h4 class="font-semibold">{tr.animals.import.title}</h4>
                <p class="text-sm text-muted-foreground leading-relaxed">{tr.animals.import.desc}</p>
              </div>
            </div>
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
              <div class="pt-6 px-6 pb-6 space-y-2">
                <h4 class="font-semibold">{tr.animals.treatments.title}</h4>
                <p class="text-sm text-muted-foreground leading-relaxed">{tr.animals.treatments.desc}</p>
              </div>
            </div>
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
              <div class="pt-6 px-6 pb-6 space-y-2">
                <h4 class="font-semibold">{tr.animals.turnout.title}</h4>
                <p class="text-sm text-muted-foreground leading-relaxed">{tr.animals.turnout.desc}</p>
              </div>
            </div>
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
              <div class="pt-6 px-6 pb-6 space-y-2">
                <h4 class="font-semibold">{tr.animals.export.title}</h4>
                <p class="text-sm text-muted-foreground leading-relaxed">{tr.animals.export.desc}</p>
              </div>
            </div>
          </div>
        </div>
        {/* Below lg the image sits under the text instead of beside it */}
        <PhoneMockup src={animalsShot} alt={tr.animals.imageAlt} wrapper="flex lg:hidden" />
      </div>

      {/* More features */}
      <div class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <h4 class="font-semibold">{tr.more.wiki.title}</h4>
              <p class="text-sm text-muted-foreground leading-relaxed">{tr.more.wiki.desc}</p>
            </div>
          </div>
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <h4 class="font-semibold">{tr.more.tasks.title}</h4>
              <p class="text-sm text-muted-foreground leading-relaxed">{tr.more.tasks.desc}</p>
            </div>
          </div>
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <h4 class="font-semibold">{tr.more.multiUser.title}</h4>
              <p class="text-sm text-muted-foreground leading-relaxed">{tr.more.multiUser.desc}</p>
            </div>
          </div>
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <h4 class="font-semibold">{tr.more.rotationDrafts.title}</h4>
              <p class="text-sm text-muted-foreground leading-relaxed">{tr.more.rotationDrafts.desc}</p>
            </div>
          </div>
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <h4 class="font-semibold">{tr.more.journals.title}</h4>
              <p class="text-sm text-muted-foreground leading-relaxed">{tr.more.journals.desc}</p>
            </div>
          </div>
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <h4 class="font-semibold">{tr.more.stats.title}</h4>
              <p class="text-sm text-muted-foreground leading-relaxed">{tr.more.stats.desc}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Customization ──────────────────────────────────────── */}
  <section class="border-t py-20">
    <div class="container mx-auto px-4 max-w-3xl space-y-10">
      <div class="space-y-4">
        <h2 class="text-3xl font-bold md:text-4xl">{tr.customize.headline}</h2>
        <p class="text-lg text-muted-foreground leading-relaxed">{tr.customize.sub}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <div class="pt-6 px-6 pb-6 space-y-2">
            <h4 class="font-semibold">{tr.customize.speedDial.title}</h4>
            <p class="text-sm text-muted-foreground leading-relaxed">{tr.customize.speedDial.desc}</p>
          </div>
        </div>
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <div class="pt-6 px-6 pb-6 space-y-2">
            <h4 class="font-semibold">{tr.customize.modules.title}</h4>
            <p class="text-sm text-muted-foreground leading-relaxed">{tr.customize.modules.desc}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Web App ────────────────────────────────────────────── */}
  <section id="webapp" class="border-t bg-muted/30 py-20">
    <div class="container mx-auto px-4 space-y-20">
      <p class="text-sm font-medium text-muted-foreground uppercase tracking-wider">
        {tr.webapp.label}
      </p>
      <div class="space-y-6 max-w-3xl">
        <h2 class="text-2xl font-bold">{tr.webapp.title}</h2>
        <p class="text-muted-foreground">{tr.webapp.body}</p>
        <p class="text-sm font-medium text-primary">{tr.webapp.memberNote}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <div class="flex items-start justify-between gap-2">
                <h4 class="font-semibold">{tr.webapp.contacts.title}</h4>
                <span class="shrink-0 inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">★ {tr.memberBadge}</span>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">{tr.webapp.contacts.desc}</p>
            </div>
          </div>
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <div class="flex items-start justify-between gap-2">
                <h4 class="font-semibold">{tr.webapp.orders.title}</h4>
                <span class="shrink-0 inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">★ {tr.memberBadge}</span>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">{tr.webapp.orders.desc}</p>
            </div>
          </div>
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <div class="flex items-start justify-between gap-2">
                <h4 class="font-semibold">{tr.webapp.sponsorships.title}</h4>
                <span class="shrink-0 inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">★ {tr.memberBadge}</span>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">{tr.webapp.sponsorships.desc}</p>
            </div>
          </div>
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="pt-6 px-6 pb-6 space-y-2">
              <h4 class="font-semibold">{tr.webapp.community.title}</h4>
              <p class="text-sm text-muted-foreground leading-relaxed">{tr.webapp.community.desc}</p>
            </div>
          </div>
        </div>
        <a
          href={appUrl}
          data-auth-redirect="/dashboard"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md bg-primary px-6 py-3 text-base font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          {tr.nav.openApp}
        </a>
      </div>
    </div>
  </section>

  {/* ── OSS ────────────────────────────────────────────────── */}
  <section id="about" class="border-t py-20">
    <div class="container mx-auto px-4 max-w-3xl space-y-8">
      <h2 class="text-3xl font-bold">{tr.story.ossTitle}</h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p>{tr.story.oss}</p>
        <p>{tr.story.data}</p>
        <p>{tr.story.funding}</p>
      </div>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-md border border-input bg-background px-6 py-3 text-base font-medium hover:bg-muted transition-colors"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        {tr.oss.github}
      </a>
    </div>
  </section>

  {/* ── Donate ─────────────────────────────────────────────── */}
  <section id="donate" class="border-t py-20">
    <div class="container mx-auto px-4 max-w-2xl space-y-6">
      <h2 class="text-3xl font-bold">{tr.donate.title}</h2>
      <p class="text-muted-foreground">{tr.donate.sub}</p>
      <DonationForm
        client:load
        apiUrl={apiUrl}
        lang={lang}
        amountLabel={tr.donate.amountLabel}
        customPlaceholder={tr.donate.customPlaceholder}
        emailLabel={tr.donate.emailLabel}
        emailPlaceholder={tr.donate.emailPlaceholder}
        cta={tr.donate.cta}
        processing={tr.donate.processing}
        error={tr.donate.error}
        errorAmount={tr.donate.errorAmount}
        errorEmail={tr.donate.errorEmail}
        thankYouTitle={tr.donate.thankYouTitle}
        thankYouBody={tr.donate.thankYouBody}
        thankYouClose={tr.donate.thankYouClose}
        closeLabel={tr.a11y.close}
      />
    </div>
  </section>

  {/* ── Newsletter ─────────────────────────────────────────── */}
  <section class="border-t py-20">
    <div class="container mx-auto px-4 max-w-2xl space-y-6">
      <h2 class="text-3xl font-bold">{tr.newsletter.title}</h2>
      <p class="text-muted-foreground">{tr.newsletter.sub}</p>
      <NewsletterForm
        client:load
        apiUrl={apiUrl}
        lang={lang}
