---
/**
 * Release notes of the mobile app, one block per store release. The app links here
 * after an update instead of carrying the notes itself; the data lives in
 * src/data/releases.ts and feeds /app-version.json as well.
 */
import type { Translations } from '@/i18n/translations'
import type { Locale } from '@/i18n/translations'
import { releasedReleases } from '@/data/releases'
import StoreBadge from '@/components/brand/StoreBadge.astro'

interface Props {
  tr: Translations
  lang: string
}

const { tr, lang } = Astro.props
const homeUrl = lang === 'de' ? '/' : `/${lang}`
const locale = lang as Locale
const dateLocale: Record<string, string> = { de: 'de-CH', fr: 'fr-CH', it: 'it-CH', en: 'en-GB' }
const formatDate = new Intl.DateTimeFormat(dateLocale[lang] ?? 'de-CH', { dateStyle: 'long', timeZone: 'Europe/Zurich' })
const releases = releasedReleases()
---

<div class="min-h-dvh bg-background text-foreground">
  <main id="main" class="container mx-auto max-w-2xl px-4 py-12 space-y-8">
    <a href={homeUrl} class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      {tr.releases.back}
    </a>

    <div class="space-y-6">
      <h1 class="text-3xl font-bold">{tr.releases.title}</h1>
      <p class="text-muted-foreground">{tr.releases.intro}</p>
      <div class="flex flex-wrap items-center gap-3">
        <StoreBadge store="ios" lang={lang} label={tr.hero.ctaIos} class="h-10" />
        <StoreBadge store="android" lang={lang} label={tr.hero.ctaAndroid} class="h-10" />
      </div>

      {releases.map((release) => (
        <section class="space-y-2 border-t border-border pt-6">
          <h2 class="text-xl font-semibold">{tr.releases.version.replace('{version}', release.version)}</h2>
          <p class="text-sm text-muted-foreground">
            {tr.releases.releasedOn.replace('{date}', formatDate.format(new Date(release.releasedAt)))}
          </p>
          <ul class="list-disc pl-5 space-y-1">
            {release.notes[locale].map((note) => <li>{note}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </main>
</div>
