---
/**
 * Landing target for a "subscribe" button in an email: /newsletter?e=<address>
 *
 * The address arrives in the query and prefills the form, so one click confirms. It stays
 * editable because the recipient may have registered with a different address. QUELLE is
 * `app` here, not `landing`: the people we send this to have an app account.
 */
import type { Translations } from '@/i18n/translations'
import { NewsletterForm } from '@/components/NewsletterForm'

interface Props {
  tr: Translations
  lang: string
}

const { tr, lang } = Astro.props
const homeUrl = lang === 'de' ? '/' : `/${lang}`
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'https://api.coltivio.ch'
---

<div class="min-h-dvh bg-background text-foreground">
  <main id="main" class="container mx-auto max-w-2xl px-4 py-12 space-y-8">
    <a href={homeUrl} class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      {tr.dataDeletion.back}
    </a>

    <div class="space-y-6">
      <h1 class="text-3xl font-bold">{tr.newsletterOptIn.title}</h1>
      <p class="text-muted-foreground">{tr.newsletterOptIn.intro}</p>
      <p class="text-sm text-muted-foreground">{tr.newsletterOptIn.emailNote}</p>
      <NewsletterForm
        client:load
        apiUrl={apiUrl}
        lang={lang}
        emailFromQuery="e"
        source="app"
        label={tr.newsletter.label}
        placeholder={tr.newsletter.placeholder}
        cta={tr.newsletterOptIn.cta}
        successMsg={tr.newsletter.success}
        errorMsg={tr.newsletter.error}
        captchaMsg={tr.newsletter.captcha}
      />
    </div>
  </main>
</div>
