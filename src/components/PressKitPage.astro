---
/**
 * The press and brand kit: copy to quote, coverage so far, and every logo, colour and
 * image a newsroom or partner needs, each as a direct download. The files and their
 * names come from src/lib/brand-kit.ts, the articles from src/lib/press.ts.
 *
 * Same frame as the release notes: a short gradient band, the white page, the ink
 * footer. The content runs wider than there because the image grids need the room.
 */
import { Image } from 'astro:assets'
import type { Translations } from '@/i18n/translations'
import type { Locale } from '@/i18n/translations'
import { COLORS, LOGOS, MOCKUPS, VISUALS, WEBAPP, type Scene } from '@/lib/brand-kit'
import { PRESS_COVERAGE } from '@/lib/press'
import { buttonClass } from '@/lib/button'
import { LanguageSwitcher } from '@/components/LanguageSwitcher'
import Logo from '@/components/brand/Logo.astro'
import LogoMark from '@/components/brand/LogoMark.astro'
import Lineart from '@/components/brand/Lineart.astro'
import Wave from '@/components/brand/Wave.astro'

interface Props {
  tr: Translations
  lang: string
}

const { tr, lang } = Astro.props
const t = tr.pressKit
const locale = lang as Locale
const homeUrl = lang === 'de' ? '/' : `/${lang}`

const CONTACT_EMAIL = 'verein@coltivio.ch'
const [contactBefore, contactAfter] = t.contact.split('{email}')

// Same card and heading scale as Landing.astro.
const CARD = 'rounded-lg border border-brand-sage/40 bg-card text-card-foreground p-6'
const H2_SECTION = 'text-3xl font-bold tracking-tight md:text-4xl'
const H3_SUBSECTION = 'text-2xl font-bold tracking-tight'
const CARD_TITLE = 'font-semibold'
const DOWNLOAD = buttonClass('secondary', 'sm', 'px-3 py-1.5')

const sections = [
  { id: 'about', label: t.aboutTitle },
  { id: 'coverage', label: t.coverageTitle },
  { id: 'logo', label: t.logoTitle },
  { id: 'colors', label: t.colorsTitle },
  { id: 'type', label: t.typeTitle },
  { id: 'images', label: t.imagesTitle },
]

const legalLinks = [
  { href: lang === 'de' ? '/imprint' : `/${lang}/imprint`, label: tr.imprint.title },
  { href: lang === 'de' ? '/privacy' : `/${lang}/privacy`, label: tr.privacy.title },
  { href: lang === 'de' ? '/data-deletion' : `/${lang}/data-deletion`, label: tr.dataDeletion.title },
  { href: lang === 'de' ? '/data-sources' : `/${lang}/data-sources`, label: tr.dataSources.title },
  { href: lang === 'de' ? '/releases' : `/${lang}/releases`, label: tr.releases.title },
]

const sceneGroups: { title: string; intro: string; scenes: Scene[] }[] = [
  { title: t.visualsTitle, intro: t.visualsIntro, scenes: VISUALS },
  { title: t.webappTitle, intro: t.visualsIntro, scenes: WEBAPP },
]
---

<div class="flex min-h-dvh flex-col bg-background text-foreground">
  <header class="brand-band on-brand overflow-hidden">
    <div class="brand-band-shade absolute inset-0 -z-30" aria-hidden="true"></div>
    <div
      class="absolute top-[30%] -right-[8%] -z-20 h-[90%]"
      style="--logo-mark: color-mix(in oklab, var(--brand-sage) 34%, transparent); --logo-mark-to: color-mix(in oklab, var(--brand-sage) 8%, transparent)"
      aria-hidden="true"
    >
      <LogoMark shaded class="h-full w-auto" />
    </div>
    <Lineart class="absolute inset-x-0 bottom-0 -z-10 h-[70%] opacity-60" />
    <Wave fill="var(--background)" class="absolute inset-x-0 -bottom-px h-[clamp(3rem,10vw,6rem)]" />

    <div class="container relative z-10 mx-auto max-w-5xl px-4 pt-6 pb-28 sm:pb-32">
      <div class="flex items-center justify-between gap-4">
        <a href={homeUrl} aria-label={t.back} class="inline-flex rounded-md">
          <Logo class="h-7 w-auto" />
        </a>
        <LanguageSwitcher client:load lang={lang} onDark />
      </div>

      <h1 class="mt-14 text-4xl font-bold tracking-tight sm:text-5xl">{t.title}</h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85">{t.intro}</p>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label={t.title}>
        {sections.map((s) => (
          <a href={`#${s.id}`} class={buttonClass('onBrandGlass', 'sm')}>{s.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main" class="container mx-auto w-full max-w-5xl flex-1 space-y-20 px-4 py-14 md:py-16">
    <section id="about" class="scroll-mt-8 space-y-6">
      <h2 class={H2_SECTION}>{t.aboutTitle}</h2>
      <div class="grid gap-6 md:grid-cols-[2fr_1fr]">
        <div class="space-y-6">
          {[
            { label: t.aboutShortLabel, text: t.aboutShort },
            { label: t.aboutLongLabel, text: t.aboutLong },
          ].map((block) => (
            <div class:list={[CARD, 'space-y-3']}>
              <div class="flex items-center justify-between gap-4">
                <h3 class={CARD_TITLE}>{block.label}</h3>
                <button type="button" class={DOWNLOAD} data-copy={block.text} data-copied={t.copied}>{t.copy}</button>
              </div>
              <p class="leading-relaxed text-muted-foreground">{block.text}</p>
            </div>
          ))}
        </div>
        <div class="space-y-6">
          <ul class:list={[CARD, 'list-disc space-y-2 pl-10 leading-relaxed']}>
            {t.facts.map((fact) => <li>{fact}</li>)}
          </ul>
          <div class:list={[CARD, 'space-y-2']}>
            <h3 class={CARD_TITLE}>{t.contactTitle}</h3>
            <p class="leading-relaxed text-muted-foreground">
              {contactBefore}<a href={`mailto:${CONTACT_EMAIL}`} class="font-medium text-primary underline underline-offset-4 hover:text-primary/80">{CONTACT_EMAIL}</a>{contactAfter}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="coverage" class="scroll-mt-8 space-y-6">
      <h2 class={H2_SECTION}>{t.coverageTitle}</h2>
      <ul class="space-y-4">
        {PRESS_COVERAGE.map((article) => (
          <li class:list={[CARD, 'flex flex-wrap items-center justify-between gap-4']}>
            <div>
              <p class="text-sm text-muted-foreground">{article.outlet[locale]} {article.issue}</p>
              <p class="text-lg font-semibold">«{article.title[locale]}»</p>
            </div>
            <a href={article.url[locale]} target="_blank" rel="noopener" class={DOWNLOAD}>{tr.press.articleLink}</a>
          </li>
        ))}
      </ul>
    </section>

    <section id="logo" class="scroll-mt-8 space-y-6">
      <h2 class={H2_SECTION}>{t.logoTitle}</h2>
      <p class="max-w-2xl leading-relaxed text-muted-foreground">{t.logoIntro}</p>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {LOGOS.map((logo) => (
          <li class="overflow-hidden rounded-lg border border-brand-sage/40">
            <div class:list={['flex h-36 items-center justify-center p-6', logo.reversed ? 'bg-brand-deep' : 'bg-surface']}>
              <img src={logo.preview} alt="" class="max-h-full max-w-full" loading="lazy" />
            </div>
            <div class="space-y-3 p-4">
              <p class={CARD_TITLE}>
                {t.logos[logo.key]}{logo.reversed && <span class="font-normal text-muted-foreground">, {t.reversed}</span>}
              </p>
              <div class="flex flex-wrap gap-2">
                {logo.files.map((file) => (
                  <a href={file.href} download={file.filename} class={DOWNLOAD}>{file.format}</a>
                ))}
              </div>
            </div>
          </li>
        ))}
      </ul>
      <ul class="max-w-2xl list-disc space-y-1 pl-5 leading-relaxed text-muted-foreground">
        {t.logoRules.map((rule) => <li>{rule}</li>)}
      </ul>
    </section>

    <section id="colors" class="scroll-mt-8 space-y-6">
      <h2 class={H2_SECTION}>{t.colorsTitle}</h2>
      <p class="max-w-2xl leading-relaxed text-muted-foreground">{t.colorsIntro}</p>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {COLORS.map((color) => (
          <li class="overflow-hidden rounded-lg border border-brand-sage/40">
            <div class="h-28" style={`background: var(${color.token})`}></div>
            <div class="space-y-1 p-4">
              <p class={CARD_TITLE}>{t.colors[color.key]}</p>
              <p class="font-mono text-sm">{color.hex}</p>
              <p class="font-mono text-sm text-muted-foreground">RGB {color.rgb}</p>
              <button type="button" class:list={[DOWNLOAD, 'mt-2']} data-copy={color.hex} data-copied={t.copied}>{t.copy}</button>
            </div>
          </li>
        ))}
      </ul>
      <div class="overflow-hidden rounded-lg border border-brand-sage/40">
        <div class="h-20" style="background: linear-gradient(90deg, var(--brand-deep), var(--brand-sage))"></div>
        <p class="p-4 font-mono text-sm">
          <span class="font-sans font-semibold">{t.gradient}</span> {COLORS[0].hex} → {COLORS[1].hex}
        </p>
      </div>
    </section>

    <section id="type" class="scroll-mt-8 space-y-6">
      <h2 class={H2_SECTION}>{t.typeTitle}</h2>
      <p class="max-w-2xl leading-relaxed text-muted-foreground">{t.typeIntro}</p>
      <div class:list={[CARD, 'space-y-4']}>
        <p class="text-sm text-muted-foreground">Inter Bold</p>
        <p class="text-3xl font-bold tracking-tight text-primary md:text-4xl">{t.typeSample}</p>
        <p class="pt-2 text-sm text-muted-foreground">Inter Regular</p>
        <p class="text-xl md:text-2xl">{t.typeSample}</p>
        <p class="font-mono text-sm text-muted-foreground">Aa Bb Cc Ää Öö Üü Éé Àà Çç 0123456789</p>
      </div>
      <a href="https://rsms.me/inter/" target="_blank" rel="noopener" class={buttonClass('primary', 'sm')}>{t.typeLink}</a>
    </section>

    <section id="images" class="scroll-mt-8 space-y-14">
      <h2 class={H2_SECTION}>{t.imagesTitle}</h2>

      <div class="space-y-6">
        <h3 class={H3_SUBSECTION}>{t.mockupsTitle}</h3>
        <p class="max-w-2xl leading-relaxed text-muted-foreground">{t.mockupsIntro}</p>
        <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
          {MOCKUPS.map((mockup) => (
            <li class="overflow-hidden rounded-lg border border-brand-sage/40">
              {/* The renders carry a wide transparent margin around the phone, so the
                  preview zooms in on the device rather than showing a small phone. */}
              <div class="relative aspect-[1/2] overflow-hidden bg-surface">
                <Image
                  src={mockup.preview}
                  alt={t.screens[mockup.key]}
                  width={1000}
                  class="absolute top-1/2 left-1/2 h-[118%] w-auto max-w-none -translate-x-1/2 -translate-y-1/2"
                  loading="lazy"
                />
              </div>
              <div class="space-y-3 p-3">
                <p class:list={[CARD_TITLE, 'text-sm']}>{t.screens[mockup.key]}</p>
                <div class="flex flex-wrap gap-2">
                  <a href={mockup.front.href} download={mockup.front.filename} class={DOWNLOAD}>{t.front}</a>
                  <a href={mockup.angle.href} download={mockup.angle.filename} class={DOWNLOAD}>{t.angle}</a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      {sceneGroups.map((group) => (
        <div class="space-y-6">
          <h3 class={H3_SUBSECTION}>{group.title}</h3>
          <p class="max-w-2xl leading-relaxed text-muted-foreground">{group.intro}</p>
          <ul class="grid gap-6 md:grid-cols-2">
            {group.scenes.map((scene) => (
              <li class="overflow-hidden rounded-lg border border-brand-sage/40">
                <Image src={scene.preview} alt={t.scenes[scene.key]} width={800} class="aspect-video w-full object-cover" loading="lazy" />
                <div class="space-y-3 p-4">
                  <p class={CARD_TITLE}>{t.scenes[scene.key]}</p>
                  <div class="flex flex-wrap gap-2">
                    {scene.files.map(({ ground, file }) => (
                      <a href={file.href} download={file.filename} class={DOWNLOAD}>
                        {t.grounds[ground]} <span class="text-muted-foreground">{file.format}</span>
                      </a>
                    ))}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="space-y-3">
      <h2 class={H3_SUBSECTION}>{t.usageTitle}</h2>
      <p class="max-w-2xl leading-relaxed text-muted-foreground">{t.usage}</p>
    </section>
  </main>

  <footer class="relative isolate overflow-hidden bg-brand-ink text-white">
    <Lineart class="absolute inset-x-0 bottom-0 -z-10 h-2/3 w-full opacity-25" />
    <div class="container relative z-10 mx-auto max-w-5xl space-y-6 px-4 pt-10 pb-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <a href={homeUrl} class="inline-flex rounded-md"><Logo class="h-7 w-auto" /></a>
        <p class="text-sm text-white/70">{tr.footer.tagline}</p>
      </div>
      <div class="flex flex-wrap items-center gap-4 border-t border-white/15 pt-5 text-sm text-white/70">
        {legalLinks.map((link) => (
          <a href={link.href} class="rounded-md transition-colors hover:text-white hover:underline">{link.label}</a>
        ))}
        <span class="ml-auto">© 2026 Coltivio</span>
      </div>
    </div>
  </footer>
</div>

<script>
  // One handler for every copy button: the text to copy and the confirmation both ride
  // on data attributes, so the markup stays the only place that knows the copy.
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('button[data-copy]')
    if (!button) return
    await navigator.clipboard.writeText(button.dataset.copy ?? '')
    const label = button.textContent
    button.textContent = button.dataset.copied ?? label
    setTimeout(() => (button.textContent = label), 1500)
  })
</script>
