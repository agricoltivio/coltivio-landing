---
import { Image } from 'astro:assets'

interface Props {
  /** Imported from src/assets so Astro can resize and convert it. */
  src: ImageMetadata
  alt: string
  /** Rotation applied to the device frame, e.g. "md:-rotate-3". */
  rotate?: string
  /** Layout and visibility classes for the wrapper, e.g. "hidden lg:flex". */
  wrapper?: string
  /** Hero mockup is the LCP element and must not be lazy. */
  eager?: boolean
}

const { src, alt, rotate = '', wrapper = 'flex', eager = false } = Astro.props

// The frame is w-52 (208px). Three times that covers every sensible DPR.
const RENDER_WIDTH = 624
---

<div class:list={['justify-center', wrapper]}>
  <div
    class:list={[
      rotate,
      'relative w-52 rounded-[2.5rem] border-4 border-foreground/15 shadow-2xl overflow-hidden aspect-[9/19] bg-muted',
    ]}
  >
    <div class="absolute top-3 left-1/2 -translate-x-1/2 w-16 h-4 rounded-full bg-foreground/10 z-10"></div>
    <Image
      src={src}
      alt={alt}
      width={RENDER_WIDTH}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="absolute inset-0 h-full w-full object-cover"
    />
  </div>
</div>
