---
/**
 * The contour pattern from the 2026 brand kit: six nested arcs in the kit's
 * green ramp, meant to read like field contours on a slope. Inlined rather
 * than loaded as an image so it can be recoloured, and because a 380 KB PNG
 * behind a hero is not a background, it is a payload.
 *
 * The arcs are drawn far outside the viewBox on purpose. Only the crest of
 * each one is visible, which is what gives the sweep.
 *
 * `preserveAspectRatio="none"` is deliberate: the kit's artboard is a band
 * about two and a half times wider than it is tall, and the pattern only reads
 * as contour lines while it stays a band. Let it keep its aspect ratio inside a
 * section box and the arcs stand up and cut diagonally across the content
 * instead of lying under it. Give it both a width and a height, and let it
 * squash.
 *
 * Geometry taken verbatim from assets/lineart.svg.
 */
interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<svg
  viewBox="0 0 1320 572.77"
  preserveAspectRatio="none"
  fill="none"
  stroke-miterlimit="10"
  {/* The band is squashed, so without this the strokes would come out
      elliptical: thicker on the vertical parts of each arc than the horizontal. */}
  vector-effect="non-scaling-stroke"
  class:list={className}
  aria-hidden="true"
>
  <path
    stroke="#2a5159"
    stroke-width="1"
    d="M-173.14,848.67c0-268.82,356.03-486.74,795.2-486.74s795.2,217.92,795.2,486.74S492.39,389.97,53.21,389.97s-226.34,727.51-226.34,458.69Z"
  />
  <path
    stroke="#3c6b67"
    stroke-width="1.2"
    d="M-92.62,824.03c0-255.21,338-510.17,754.94-510.17s754.94,254.96,754.94,510.17S687.28,391.18,270.33,391.18-92.62,1079.23-92.62,824.03Z"
  />
  <path
    stroke="#4d8674"
    stroke-width="1.4"
    d="M-12.09,799.38c0-241.6,319.97-533.6,714.68-533.6s714.68,292,714.68,533.6S882.17,392.38,487.46,392.38-12.09,1040.98-12.09,799.38Z"
  />
  <path
    stroke="#5fa082"
    stroke-width="1.6"
    d="M68.43,774.74c0-227.99,301.95-557.03,674.42-557.03s674.42,329.04,674.42,557.03-340.21-381.16-712.68-381.16S68.43,1002.73,68.43,774.74Z"
  />
  <path
    stroke="#70bb8f"
    stroke-width="1.8"
    d="M148.95,750.1c0-214.38,283.92-580.46,634.16-580.46s634.16,366.08,634.16,580.46-145.31-355.31-495.55-355.31S148.95,964.47,148.95,750.1Z"
  />
  <path
    stroke="#82d59d"
    stroke-width="2"
    d="M229.47,725.45c0-200.77,265.9-603.88,593.9-603.88s593.9,403.12,593.9,603.88,49.58-329.47-278.42-329.47S229.47,926.22,229.47,725.45Z"
  />
</svg>
