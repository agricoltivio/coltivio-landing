 * which defaults to the kit's mint.
 *
 * Geometry taken verbatim from assets/logo/logo/logo-hor-reversed.svg. Do not
 * redraw the paths by hand.
 */
interface Props {
  /** Accessible name. Empty renders the lockup as decoration. */
  title?: string
  class?: string
}

