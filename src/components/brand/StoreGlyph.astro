---
/**
 * The two store marks as vectors, so the download buttons are real buttons with
 * real text rather than two PNG badges that blur on a retina screen and carry
 * their label inside the pixels where no screen reader can reach it.
 *
 * Both are drawn in `currentColor` and inherit the button's own text colour.
 */
interface Props {
  store: 'ios' | 'android'
  class?: string
}

const { store, class: className = 'h-5 w-5 shrink-0' } = Astro.props
---

{
  store === 'ios' ? (
    <svg viewBox="0 0 24 24" fill="currentColor" class:list={className} aria-hidden="true">
      <path d="M17.05 12.54c-.03-2.6 2.12-3.85 2.22-3.91-1.21-1.77-3.09-2.01-3.76-2.04-1.6-.16-3.12.94-3.93.94-.81 0-2.06-.92-3.39-.9-1.74.03-3.35 1.01-4.24 2.57-1.81 3.14-.46 7.79 1.3 10.34.86 1.25 1.88 2.65 3.22 2.6 1.29-.05 1.78-.84 3.34-.84s2 .84 3.37.81c1.39-.02 2.27-1.27 3.12-2.53.98-1.45 1.39-2.86 1.41-2.93-.03-.01-2.7-1.04-2.73-4.11M14.5 4.76c.71-.86 1.19-2.06 1.06-3.26-1.02.04-2.26.68-3 1.54-.66.76-1.24 1.98-1.08 3.15 1.14.09 2.31-.58 3.02-1.43" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" fill="currentColor" class:list={className} aria-hidden="true">
      <path d="M3.6 1.84a1.5 1.5 0 0 0-.35.97v18.38c0 .37.13.71.35.97l.06.06 10.3-10.16v-.12L3.66 1.78l-.06.06M17.4 15.6 14 12.24v-.12l3.4-3.36.08.05 4.05 2.26c1.16.65 1.16 1.71 0 2.36l-4.05 2.26-.08.05M16.55 16.5 13.06 13.06 2.7 23.28c.38.4 1.02.45 1.73.06l12.12-6.84M16.55 7.5 4.43.66C3.72.27 3.08.32 2.7.72l10.36 10.22L16.55 7.5" />
    </svg>
  )
}
