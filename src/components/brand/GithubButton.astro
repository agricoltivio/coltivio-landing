---
/**
 * The GitHub link, dressed as a third badge so the footer row reads as one.
 *
 * Half of this is official and half of it is not, and the split matters. GitHub ships no
 * equivalent of the two store buttons, only the mark, so the artwork below is theirs (the
 * `mark-github` octicon from GitHub's own Primer set, unaltered, white on a dark ground as
 * their guidelines require) and the pill around it is ours. The pill copies the Apple badge
 * standing next to it: same height, same corner radius, same #a6a6a6 keyline, so the three
 * sit level rather than one text link floating beside two heavy black buttons.
 *
 * Never restyle the mark itself. Solid black or solid white only, no gradient, no brand
 * colour, no outline version.
 *
 * Height comes from the caller through `class`. The mark follows it as a share of the
 * container height, but the label and the padding are set for `h-8`, the footer size; give
 * them a look if this is ever used larger.
 */
import { GITHUB_URL } from '@/lib/links'

interface Props {
  /** The visible wording, so the link reads the same to a screen reader. */
  label: string
  class?: string
}

const { label, class: className = 'h-8' } = Astro.props

// The keyline Apple prints around its badge. Hard-coded rather than tokenised because it
// belongs to the badge next to it, not to our palette, and has to follow it if it changes.
const APPLE_KEYLINE = '#a6a6a6'
---

<a
  href={GITHUB_URL}
  target="_blank"
  rel="noopener noreferrer"
  style={`border-color: ${APPLE_KEYLINE}`}
  class:list={[
    'inline-flex items-center justify-center gap-1.5 rounded-md border bg-black px-2.5 font-semibold whitespace-nowrap text-white transition-opacity hover:opacity-80',
    className,
  ]}
>
  {/* GitHub's mark, at the share of the badge height Apple gives its own. */}
  <svg viewBox="0 0 24 24" fill="currentColor" class="h-[45%] w-auto shrink-0" aria-hidden="true">
    <path
      d="M12.5.75C6.146.75 1 5.896 1 12.25c0 5.089 3.292 9.387 7.863 10.91.575.101.79-.244.79-.546 0-.273-.014-1.178-.014-2.142-2.889.532-3.636-.704-3.866-1.35-.13-.331-.69-1.352-1.18-1.625-.402-.216-.977-.748-.014-.762.906-.014 1.553.834 1.769 1.179 1.035 1.74 2.688 1.25 3.349.948.1-.747.402-1.25.733-1.538-2.559-.287-5.232-1.279-5.232-5.678 0-1.25.445-2.285 1.178-3.09-.115-.288-.517-1.467.115-3.048 0 0 .963-.302 3.163 1.179.92-.259 1.897-.388 2.875-.388.977 0 1.955.13 2.875.388 2.2-1.495 3.162-1.179 3.162-1.179.633 1.581.23 2.76.115 3.048.733.805 1.179 1.825 1.179 3.09 0 4.413-2.688 5.39-5.247 5.678.417.36.776 1.05.776 2.128 0 1.538-.014 2.774-.014 3.162 0 .302.216.662.79.547C20.709 21.637 24 17.324 24 12.25 24 5.896 18.854.75 12.5.75Z"
    />
  </svg>
  <span class="text-[0.8125rem] leading-none">{label}</span>
</a>
