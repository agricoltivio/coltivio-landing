---
import Base from '@/layouts/Base.astro'
import NewsletterOptInPage from '@/components/NewsletterOptInPage.astro'
import { getTranslations } from '@/i18n/translations'

const lang = 'de'
const tr = getTranslations(lang)
---

<Base lang={lang} title={`${tr.newsletterOptIn.title} | Coltivio`} description={tr.newsletterOptIn.title} noindex>
  <NewsletterOptInPage tr={tr} lang={lang} />
</Base>
