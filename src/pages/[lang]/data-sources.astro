---
import Base from '@/layouts/Base.astro'
import DataSourcesPage from '@/components/DataSourcesPage.astro'
import { getTranslations } from '@/i18n/translations'

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
  ]
}

const { lang } = Astro.params
const tr = getTranslations(lang)
---

<Base lang={lang} title={`${tr.dataSources.title} | Coltivio`} description={tr.dataSources.title}>
  <DataSourcesPage tr={tr} lang={lang} />
</Base>
