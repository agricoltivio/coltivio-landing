---
import Base from '@/layouts/Base.astro'
import ReleasesPage from '@/components/ReleasesPage.astro'
import { getTranslations } from '@/i18n/translations'

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
  ]
}

const { lang } = Astro.params
const tr = getTranslations(lang)
---

<Base lang={lang} title={`${tr.releases.title} | Coltivio`} description={tr.releases.intro}>
  <ReleasesPage tr={tr} lang={lang} />
</Base>
