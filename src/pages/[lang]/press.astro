---
import Base from '@/layouts/Base.astro'
import PressKitPage from '@/components/PressKitPage.astro'
import { getTranslations } from '@/i18n/translations'

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
  ]
}

const { lang } = Astro.params
const tr = getTranslations(lang)
---

<Base lang={lang} title={`${tr.pressKit.title} | Coltivio`} description={tr.pressKit.intro}>
  <PressKitPage tr={tr} lang={lang} />
</Base>
